rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: ships
    // Document ID: {shipId}
    // Fields:
    //   - x: number
    //   - y: number
    //   - r: number
    //   - color: string
    //   - memo: string (optional)
    //
    // Collection: zones
    // Document ID: {zoneId}
    // Fields:
    //   - x: number
    //   - y: number
    //   - r: number
    //
    // Collection: history
    // Document ID: {logId}
    // Fields:
    //   - action: string
    //   - shipId: string
    //   - author: string
    //   - timestamp: number
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * 이 앱의 주인. **접속기록을 읽을 수 있는 유일한 사람**이다.
     *
     * ★uid 가 아니라 **확인된 이메일**로 가른다. uid 는 사람이 한 번 로그인해야
     *  생기는 값이라 왕복이 필요하고, 저장소를 지우면 바뀔 위험을 따져야 한다.
     *  이메일은 구글이 보증하고 영구적이다.
     * ★`email_verified` 를 반드시 같이 본다. 이걸 빼면 이메일만 같게 만든 다른
     *  공급자 계정으로 통과할 수 있다.
     * ★이 주소는 이 레포의 **커밋 작성자로 이미 공개돼 있다**(git log). 규칙에 적어도
     *  새로 새는 정보가 없다. 그리고 이메일은 비밀번호가 아니다 — 알아도 못 들어온다.
     */
    function isOwner() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'iris8ooooo@gmail.com';
    }

    function isValidShip(data) {
      return data.keys().hasAll(['x', 'y', 'r', 'color']) &&
             data.x is number &&
             data.y is number &&
             data.r is number &&
             data.color is string &&
             (!('memo' in data) || data.memo is string);
    }

    function isValidZone(data) {
      return data.keys().hasAll(['x', 'y', 'r']) &&
             data.x is number &&
             data.y is number &&
             data.r is number &&
             (!('isLocked' in data) || data.isLocked is bool);
    }

    function isValidHistoryLog(data) {
      return data.keys().hasAll(['action', 'shipId', 'author', 'timestamp']) &&
             data.action is string &&
             data.shipId is string &&
             data.author is string &&
             data.timestamp is number;
    }

    match /ships/{shipId} {
      allow read: if true;
      allow create: if isValidShip(request.resource.data);
      allow update: if isValidShip(request.resource.data);
      allow delete: if true;
    }

    match /zones/{zoneId} {
      allow read: if true;
      allow create: if isValidZone(request.resource.data);
      allow update: if isValidZone(request.resource.data);
      allow delete: if true;
    }

    match /history/{logId} {
      allow read: if true;
      allow create: if isValidHistoryLog(request.resource.data);
      allow update, delete: if false;
    }

    // 3중점검 수집 심장박동 하나만 산다. 앱이 "마지막 수집이 언제였나" 를
    // 보여주는 용도라, 문서 id 를 safetyone 으로 고정해 잡동사니가 못 늘게 한다.
    // ── 접속 집계 (2026-09-05) ─────────────────────────────────────
    // 누가 얼마나 자주 앱을 여는지. **읽기는 오너 한 사람만** — 이 앱은 공개 주소라
    // 읽기를 안 막으면 접속기록이 전 세계 공개가 된다.
    //
    // ★쓰기에 인증을 요구하지 않는다. 익명 인증을 켜려면 파이어베이스 콘솔을
    //  사람이 한 번 눌러야 하고, 그 한 클릭 때문에 기능 전체가 멈춘다.
    //  대신 기기 id 를 브라우저가 만들어 보낸다 — **위조 가능**하다는 뜻이고,
    //  그건 "접속 수를 부풀릴 수 있다" 까지다(남의 기록을 읽거나 지우지는 못한다).
    //  사내 도구에서 그 위험은 감수할 만하다. 정확한 사람 수가 필요해지면
    //  그때 익명 인증으로 올린다.
    //
    // ★`hasOnly` 로 필드를 봉인한다. 앱이 나중에 실수로든 편의로든 IP·User-Agent·
    //  전체 URL 을 한 줄 붙이면 **쓰기가 거부된다** — "안 모으기로 했다" 는 약속이
    //  지킬 사람 없이도 성립하게 만드는 장치다.
    // ★시각은 `request.time` 으로 **서버가 찍는다.** 클라이언트 시계를 믿으면
    //  날짜별 집계가 조용히 어긋난다.
    // ★수정·삭제는 아무도 못 한다. 오너도 못 지운다 — 기록은 기록이어야 한다.
    match /visits/{visitId} {
      allow read: if isOwner();
      allow create: if request.resource.data.keys().hasOnly(['device', 'name', 'at']) &&
                       request.resource.data.device is string &&
                       request.resource.data.device.size() >= 8 &&
                       request.resource.data.device.size() <= 40 &&
                       request.resource.data.name is string &&
                       request.resource.data.name.size() <= 20 &&
                       request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ── 직원 명단 ────────────────────────────────────────────────────────────
    // 「누가 봤나」 집계에서 **명단 밖 이름을 알아보기 위한 참고표**다. 문지기가 아니다.
    //
    // ★★**아무도 막지 않는다** (2026-09-05 사용자 결정). `visits` 쓰기는 이 명단을
    //  보지 않는다 — 명단에 없는 사람도 이름을 적을 수 있고 지도도 그대로 쓴다.
    //  막는 쪽으로 갔다면 **신입이 앱을 못 쓰고, 그 사실을 오너는 모른다.** 신입은
    //  그냥 안 쓰게 되고 끝이다. 실측: 두 명단(2026.04 → 08.20) 사이 4개월에
    //  6명이 들어오고 4명이 빠졌다 — 월 1.5명꼴이라 드문 일이 아니다.
    //  대신 집계창이 「명단 밖」으로 표시하고, 신입이면 오너가 탭 한 번으로 넣는다.
    //  **앱이 새 사람을 먼저 알려주는 구조**라 명단을 미리 챙길 필요가 없다.
    //
    // ★**읽기는 오너만.** 이 레포는 공개이고 앱 번들도 공개다. 명단을 코드에 박으면
    //  회사 인원 명부를 인터넷에 공개하는 것이 된다. 그래서 이름은 **여기에만** 산다.
    // ★**쓰기도 오너만.** 아무나 이름을 넣을 수 있으면 「명단 밖」 표시가 무의미해진다.
    // ★이름이 곧 문서 id 다. 그래야 중복이 저절로 없어지고 `exists()` 한 번으로 끝난다.
    // ★연락처·사번·생년월일은 **넣지 않는다.** 필요한 것은 이름뿐이고, 필드를 봉인해
    //  나중에 누가 편의로 한 줄 붙이는 것까지 막는다.
    match /staff/{name} {
      allow read: if isOwner();
      allow create, update: if isOwner() &&
                       request.resource.data.keys().hasOnly(['addedAt']) &&
                       request.resource.data.addedAt == request.time;
      allow delete: if isOwner();
    }

    match /meta/safetyone {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['lastSuccess']) &&
                      request.resource.data.lastSuccess is number;
    }

    // ── 조석예보 (2026-09-05) ────────────────────────────────────────────
    // 국립해양조사원 고·저조 예보. 깃허브 액션(sync-tide.yml)이 하루 한 번 쓰고 앱이 읽는다.
    // 모양은 src/lib/tide.mjs 의 buildTideDoc 이 만든다: station · days(날짜별 배열) · lastSuccess · source.
    // ★쓰기는 meta/safetyone 과 같은 방식(인증 없음)이다 — 액션이 웹 SDK 로 쓰는 기존 패턴을 그대로 따른다.
    //  대신 `hasOnly` 로 필드를 봉인하고 자료형을 본다. 앱은 days[오늘] 이 없으면 「예보 없음」 을 그리므로
    //  이상한 모양이 들어와도 지어낸 값이 화면에 나가지는 않는다.
    match /meta/tide {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['station', 'days', 'lastSuccess', 'source']) &&
                      request.resource.data.keys().hasAll(['station', 'days', 'lastSuccess']) &&
                      request.resource.data.station is map &&
                      request.resource.data.station.code is string &&
                      request.resource.data.days is map &&
                      request.resource.data.days.size() >= 1 &&
                      request.resource.data.lastSuccess is number;
    }
  }
}
